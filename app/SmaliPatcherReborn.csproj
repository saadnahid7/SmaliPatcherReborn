<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SmaliPatcherReborn</AssemblyName>
    <RootNamespace>SmaliPatcherReborn</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets/app.ico')">Assets/app.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <Version>0.4.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.2.5" />
    <PackageReference Include="Avalonia.Desktop" Version="11.2.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.2.5" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.2.5" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/icon.png" />
  </ItemGroup>

  <!-- The module (which contains the on-device patch engine) and a fallback adb travel inside the executable. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets/module.zip" LogicalName="module.zip" />
    <EmbeddedResource Include="Assets/engine-pc.jar" LogicalName="engine-pc.jar" />
    <!-- PtOs = windows | linux | darwin, set by publish.ps1 -->
    <EmbeddedResource Include="cache/platform-tools-$(PtOs).zip" LogicalName="platform-tools-$(PtOs).zip" Condition="'$(PtOs)' != '' And Exists('cache/platform-tools-$(PtOs).zip')" />
  </ItemGroup>
</Project>
